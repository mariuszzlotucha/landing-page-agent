{
    "compilerOptions": {
        "target": "es2025",
        "module": "NodeNext",
        "moduleResolution":"NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipDefaultLibCheck": true,
        "types": ["node"],
        "sourceMap": true

    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}