# Required. Can also be left unset here and exported in your shell instead
# (e.g. in ~/.zshrc) — a shell-exported value takes precedence over this file.
OPENROUTER_API_KEY=

# Required. API key for the Gamma MCP server (presentation generation).
GAMMA_API_KEY=

# Optional. Defaults shown below.
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
