# Required. Can also be left unset here and exported in your shell instead
# (e.g. in ~/.zshrc) — a shell-exported value takes precedence over this file.
OPENROUTER_API_KEY=

# Optional. API key for the Gamma MCP server (presentation generation).
# Without it the agent starts with no Gamma tools.
GAMMA_API_KEY=

# Optional. Defaults shown below.
GAMMA_MCP_URL=https://mcp.leocode.ai/gamma/mcp
GAMMA_AUTH_HEADER=X-Authorization
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
